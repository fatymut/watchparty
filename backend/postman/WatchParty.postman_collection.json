{
  "info": {
    "name": "WatchParty API",
    "description": "Collection de test de l'API backend WatchParty (Go + MySQL). Suivre l'ordre des dossiers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082" },
    { "key": "partyId", "value": "1" },
    { "key": "userId", "value": "1" },
    { "key": "invitationToken", "value": "" },
    { "key": "authToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
      }
    },
    {
      "name": "1b. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"amel\",\n  \"email\": \"amel@watchparty.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/register", "host": ["{{baseUrl}}"], "path": ["api", "register"] }
          }
        },
        {
          "name": "Login (recupere le token dans la reponse)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@watchparty.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/login", "host": ["{{baseUrl}}"], "path": ["api", "login"] }
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Get Me sans token (401 attendu)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api", "me"] }
          }
        },
        {
          "name": "Get Me avec token (coller le token de Login dans la variable authToken)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Movies",
      "item": [
        {
          "name": "Create Movie",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception\",\n  \"genre\": \"Sci-Fi\",\n  \"duration\": 148,\n  \"releaseYear\": 2010,\n  \"synopsis\": \"Un voleur qui s'infiltre dans les rêves.\",\n  \"posterUrl\": \"https://example.com/inception.jpg\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/movies", "host": ["{{baseUrl}}"], "path": ["api", "movies"] }
          }
        },
        {
          "name": "List Movies",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/movies", "host": ["{{baseUrl}}"], "path": ["api", "movies"] }
          }
        },
        {
          "name": "Update Movie",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception (edition speciale)\",\n  \"genre\": \"Sci-Fi\",\n  \"duration\": 150,\n  \"releaseYear\": 2010,\n  \"synopsis\": \"...\",\n  \"posterUrl\": \"https://example.com/inception.jpg\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/movies/1", "host": ["{{baseUrl}}"], "path": ["api", "movies", "1"] }
          }
        },
        {
          "name": "Update Movie inexistant (404 attendu)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"x\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/movies/999", "host": ["{{baseUrl}}"], "path": ["api", "movies", "999"] }
          }
        },
        {
          "name": "Delete Movie (remplacer l'id par un film cree via Create Movie)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/movies/1", "host": ["{{baseUrl}}"], "path": ["api", "movies", "1"] }
          }
        }
      ]
    },
    {
      "name": "3. Parties",
      "item": [
        {
          "name": "Create Party",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Soiree du vendredi\",\n  \"description\": \"Film d'horreur\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties", "host": ["{{baseUrl}}"], "path": ["api", "parties"] }
          }
        },
        {
          "name": "List Parties",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/parties", "host": ["{{baseUrl}}"], "path": ["api", "parties"] }
          }
        },
        {
          "name": "Get Party By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}"] }
          }
        },
        {
          "name": "Update Party",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Soiree du vendredi (renommee)\",\n  \"description\": \"Film d'horreur, finalement\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}"] }
          }
        },
        {
          "name": "Close Party",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/close", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "close"] }
          }
        },
        {
          "name": "Close Party again (deja fermee -> 409 attendu)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/close", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "close"] }
          }
        },
        {
          "name": "Delete Party (a lancer en dernier, supprime tout en cascade)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Swipes",
      "item": [
        {
          "name": "Create Swipe (like)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"movieId\": 1,\n  \"value\": \"like\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/swipes", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "swipes"] }
          }
        },
        {
          "name": "List Swipes",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/swipes", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "swipes"] }
          }
        }
      ]
    },
    {
      "name": "5. Recommendation",
      "item": [
        {
          "name": "Generate Recommendation",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/recommendation/generate", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "recommendation", "generate"] }
          }
        },
        {
          "name": "Get Recommendation",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/recommendation", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "recommendation"] }
          }
        },
        {
          "name": "Recommendation sur party sans like (404 attendu)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/parties/999/recommendation/generate", "host": ["{{baseUrl}}"], "path": ["api", "parties", "999", "recommendation", "generate"] }
          }
        }
      ]
    },
    {
      "name": "6. Notation (bonus)",
      "item": [
        {
          "name": "Notation sans film choisi/recommande (400 attendu)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"rating\": 4\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/notations", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "notations"] }
          }
        },
        {
          "name": "Choose Movie",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movieId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/choose-movie", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "choose-movie"] }
          }
        },
        {
          "name": "Create Notation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"rating\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/notations", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "notations"] }
          }
        },
        {
          "name": "Update Notation (meme user, upsert)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"rating\": 3\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/notations", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "notations"] }
          }
        },
        {
          "name": "Notation invalide, rating hors 1-5 (400 attendu)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"rating\": 9\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/notations", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "notations"] }
          }
        },
        {
          "name": "List Notations (avec moyenne)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/notations", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "notations"] }
          }
        }
      ]
    },
    {
      "name": "7. Participants",
      "item": [
        {
          "name": "Add Participant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/participants", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "participants"] }
          }
        },
        {
          "name": "Add Participant (duplicate -> 409 attendu)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/participants", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "participants"] }
          }
        },
        {
          "name": "List Participants",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/participants", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "participants"] }
          }
        }
      ]
    },
    {
      "name": "8. Invitations",
      "item": [
        {
          "name": "Create Invitation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invite@watchparty.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/invitations", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "invitations"] }
          }
        },
        {
          "name": "Accept Invitation (remplacer {{invitationToken}} par le token reçu)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/invitations/{{invitationToken}}/accept", "host": ["{{baseUrl}}"], "path": ["api", "invitations", "{{invitationToken}}", "accept"] }
          }
        },
        {
          "name": "Accept Invitation again (deja utilisee -> 409 attendu)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/invitations/{{invitationToken}}/accept", "host": ["{{baseUrl}}"], "path": ["api", "invitations", "{{invitationToken}}", "accept"] }
          }
        }
      ]
    },
    {
      "name": "9. Comments",
      "item": [
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"content\": \"Hate de voir ce film !\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/comments", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "comments"] }
          }
        },
        {
          "name": "List Comments",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/comments", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "comments"] }
          }
        },
        {
          "name": "Delete Comment (remplacer l'id par un commentaire cree via Add Comment)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/comments/1", "host": ["{{baseUrl}}"], "path": ["api", "comments", "1"] }
          }
        },
        {
          "name": "Delete Comment inexistant (404 attendu)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/comments/999", "host": ["{{baseUrl}}"], "path": ["api", "comments", "999"] }
          }
        }
      ]
    },
    {
      "name": "10. Cas d'erreur",
      "item": [
        {
          "name": "Login mauvais mot de passe (401 attendu)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@watchparty.com\",\n  \"password\": \"mauvais\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/login", "host": ["{{baseUrl}}"], "path": ["api", "login"] }
          }
        },
        {
          "name": "Register email deja utilise (409 attendu)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo2\",\n  \"email\": \"demo@watchparty.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/register", "host": ["{{baseUrl}}"], "path": ["api", "register"] }
          }
        },
        {
          "name": "Swipe value invalide (400 attendu)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"movieId\": 1,\n  \"value\": \"peut-etre\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties/{{partyId}}/swipes", "host": ["{{baseUrl}}"], "path": ["api", "parties", "{{partyId}}", "swipes"] }
          }
        },
        {
          "name": "Choose Movie sur party inexistante (404 attendu)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movieId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/parties/999/choose-movie", "host": ["{{baseUrl}}"], "path": ["api", "parties", "999", "choose-movie"] }
          }
        }
      ]
    }
  ]
}
